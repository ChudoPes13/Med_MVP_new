APP_NAME=MedJarvis Registry
CLINIC_ID=medcenter
APP_TIMEZONE=Europe/Moscow
APP_HOST=127.0.0.1
APP_PORT=8000
SSL_CERTFILE=cert.pem
SSL_KEYFILE=cert-key.pem

REQUIRE_GPU=true
REQUIRE_SILERO_VAD=true

PCM_SAMPLE_RATE=16000
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_LOCAL_DIR=models/whisper/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=1

LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=Ministral-3-3B-Instruct-2512-Q5_K_M.gguf
LLAMA_TIMEOUT_SEC=8

TTS_ENABLED=true
SILERO_TTS_PATH=v5_4_ru.pt
SILERO_TTS_DEVICE=cuda
SILERO_TTS_SPEAKER=kseniya
SILERO_TTS_SAMPLE_RATE=48000

WLK_MIN_DURATION_REAL_SILENCE=1.0
VAD_ENERGY_THRESHOLD=0.004
VAD_SILENCE_RATIO=0.45
SILERO_VAD_THRESHOLD=0.45
SILERO_SPEECH_PAD_MS=120
SILERO_MIN_SILENCE_MS=250
